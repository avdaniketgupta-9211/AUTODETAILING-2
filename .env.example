DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=https://rollingsautomotive.com
INQUIRY_SALT=change-me
# Optional email notifications via Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional: server-side AI for the chat assistant. Without this, the site uses
# the verified, built-in knowledge-base responder (no external API calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: GoHighLevel/CRM webhook for chat estimate requests.
# When set, leads are delivered here and a failure is not reported as success.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
